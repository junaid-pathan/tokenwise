{
  "manifest_version": 3,
  "name": "Downshift",
  "version": "0.1.0",
  "description": "Puts AI in the right gear. Small models for easy prompts, big ones only when needed.",
  "action": { "default_title": "Downshift", "default_popup": "src/panel/index.html" },
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"],
      "js": ["src/content/content.js"]
    }
  ]
}
