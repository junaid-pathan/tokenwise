{
  "manifest_version": 3,
  "name": "Downshift",
  "version": "0.2.0",
  "description": "Puts AI in the right gear. Picks the right-size Claude model for each prompt and tracks the carbon you save.",
  "action": { "default_title": "Downshift", "default_popup": "src/panel/index.html" },
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://claude.ai/*",
    "http://localhost:8000/*"
  ],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/content/estimates.js", "src/content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
