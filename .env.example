# Copy to .env and fill in. Never commit .env. Never put real values in this file.

# Power source: estimate | nvidia-smi | cloud  (Hardware gate chose 'cloud' = Colab T4)
POWER_SOURCE=cloud

# A: Colab tunnels from sip_colab.ipynb (PR A1/A2/A3). URLs change on every restart.
OLLAMA_URL=
POWER_URL=

# B: AWS Bedrock (PR B2). Our account is locked to us-east-2.
# Easiest: a Bedrock API key (needs boto3>=1.39, pinned in requirements.txt).
AWS_REGION=us-east-2
AWS_BEARER_TOKEN_BEDROCK=
# Alternative: an IAM user limited to bedrock:InvokeModel and bedrock:Converse.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# B: EIA grid data (PR B1). Free key, instant by email: https://www.eia.gov/opendata/
EIA_API_KEY=
