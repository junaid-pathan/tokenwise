# Copy to .env and fill in. Never commit .env.

# Power source: estimate | nvidia-smi | cloud  (stays 'estimate' until Hardware gate)
POWER_SOURCE=estimate

# A: Colab Ollama tunnel URL (PR A1/A3)
OLLAMA_URL=

# B: AWS Bedrock (PR B2). Prefer an IAM user limited to bedrock:InvokeModel/Converse.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# B: EIA grid data (PR B1) — free key, instant by email
EIA_API_KEY=
